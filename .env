PORT=4501

# ── DriveInnovate's database ──────────────────────────────────────────────
# This service connects DIRECTLY to driveinnovate/server's own MySQL database
# — same DB_HOST/DB_NAME/DB_USER/DB_PASSWORD as driveinnovate/server/.env, NOT
# a separate database. It reads di_user/di_user_vehicle (read-only) and writes
# rto_details/challans (the same tables driveinnovate's API reads) plus two
# tables it owns outright: ulip_job_runs, ulip_failed_records.
#MySQL settings locaICSDC Servers
DB_USER=root
DB_PASSWORD=4hb3fYi66PW0D7aNg
DB_NAME=scsmartchallan
DB_HOST=10.87.213.247
# PG_HOST=165.99.213.247    
DB_SSL=false
DB_PORT=33166


# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=driveinnovate
# DB_USER=root
# DB_PASSWORD=your_password

# Shared secret DriveInnovate's server sends as `x-api-key` on the optional
# on-demand endpoints below (not used by the cron jobs, which call ULIP
# in-process).
ULIP_SERVICE_API_KEY=change-me

# ULIP (DPIIT) account — provision a DriveInnovate account or reuse SmartChallan's.
# The daily quota is per-account, so sharing an account shares the quota too.
ULIP_USERNAME=mmjn_technoton_usr
ULIP_PASSWORD='TsPl$5202'

ULIP_LOGIN_URL=https://www.ulip.dpiit.gov.in/ulip/v1.0.0/user/login
ULIP_VAHAN_DETAILS_URL=https://www.ulip.dpiit.gov.in/ulip/v1.0.0/VAHAN/04
ULIP_ECHALLAN_DETAILS_URL=https://www.ulip.dpiit.gov.in/ulip/v1.0.0/ECHALLAN/01

# Max ULIP API calls per second across RTO + Challan combined (ULIP does not
# publish an official cap — keep this conservative).
ULIP_RATE_LIMIT_PER_SECOND=8

# Batch endpoint: N vehicles in flight at once, then a pause before the next wave.
ULIP_BATCH_CONCURRENCY=4
ULIP_BATCH_DELAY_MS=1000

SSL_KEY=/etc/letsencrypt/live/api.technoton.co.in/privkey.pem
SSL_CERT=/etc/letsencrypt/live/api.technoton.co.in/fullchain.pem
SSL_CA=/etc/letsencrypt/live/api.technoton.co.in/chain.pem

# ── Cron schedules (Asia/Kolkata) ──────────────────────────────────────────
# RTO_JOB_CRON=0 9 * * 1        # weekly, Monday 09:00 — RTO/insurance/tax data changes slowly
# CHALLAN_JOB_CRON=0 */8 * * *  # every 8 hours
# RETRY_JOB_CRON=30 */3 * * *   # every 3 hours — retries ulip_failed_records
# ULIP_JOB_TZ=Asia/Kolkata
